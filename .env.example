# ===== TradeX sozlamalari =====
# Ishlab chiqarishda APP_ENV=production qiling
APP_ENV=development

# Ma'lumotlar bazasi. Lokal test uchun SQLite, serverda PostgreSQL:
DATABASE_URL=sqlite:///./tradex.db
# DATABASE_URL=postgresql+psycopg2://tradex:tradex@localhost:5432/tradex

# BotFather'dan olingan token (bo'sh bo'lsa ham loyiha lokal rejimda ishlaydi)
BOT_TOKEN=
BOT_USERNAME=TradeXBot

# Mini App manzili (HTTPS bo'lishi kerak, Telegram talabi)
WEBAPP_URL=http://localhost:8000/

# JWT (ishlab chiqarishda uzun tasodifiy qiymat qo'ying: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=10080

# Admin Telegram ID lar (vergul bilan)
ADMIN_TELEGRAM_IDS=

# Faqat lokal test uchun: X-Dev-User sarlavhasi orqali kirish (production'da ishlamaydi)
DEV_AUTH_BYPASS=false

# O'yin sozlamalari (virtual valyuta)
START_BALANCE=10000
REFERRAL_BONUS=500
REFERRAL_XP=100
DAILY_REWARD=100
DAILY_REWARD_XP=20

# Narx keshi (soniya) va so'rov limiti (daqiqada, IP bo'yicha)
PRICE_CACHE_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
